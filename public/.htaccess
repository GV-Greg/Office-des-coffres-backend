<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Origine canonique (29/09/2026) : https://odc-admin.creacube.be, sans www. Les quatre
    # variantes (http/https × avec/sans www) servaient toutes le panneau admin et l'API, dont
    # la page de connexion admin en clair. Même règle que le frontend (public/.htaccess, #73).
    #  - Avant la redirection des slashs finaux, qui est une 301 : placée après, elle poserait
    #    en cache chez le visiteur une redirection permanente restée en http://.
    #  - Un POST en http:// devient un GET après une 302/301 et échoue (405) : voulu. Le mot de
    #    passe est déjà parti en clair dans la première requête, un 307/308 qui la rejouerait
    #    masquerait la fuite au lieu de la faire corriger. Le frontend appelle déjà en https.
    #  - /.well-known/ exclu : le renouvellement du certificat peut y valider en http.
    #  - %{HTTPS} est fiable derrière PowerBoost (Laravel voit le vrai schéma, vérifié en prod).
    #  - 301 depuis le 01/10/2026, après une phase en 302 vérifiée en prod depuis le 29/09.
    #    Pas de HSTS (décision séparée).
    # Contrôlée à chaque déploiement par .github/workflows/deploy.yml.
    RewriteCond %{REQUEST_URI} !^/\.well-known/
    RewriteCond %{HTTPS} !=on [OR]
    RewriteCond %{HTTP_HOST} !^odc-admin\.creacube\.be$ [NC]
    RewriteRule ^(.*)$ https://odc-admin.creacube.be/$1 [R=301,L]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>
