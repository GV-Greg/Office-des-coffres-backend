APP_NAME="Office des Coffres"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://odc-admin.creacube.be

# Chiffrement des données de module (admin/strategies/donnees-utilisateur.md §5).
# JAMAIS APP_KEY : key:generate la ferait tourner et rendrait les données illisibles.
# Générer : php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
# ⚠️ À sauvegarder ailleurs que la base : si le dump SQL et le .env voyagent ensemble,
#    le chiffrement n'a rien acheté.
MODULE_DATA_KEY=
# Clés antérieures, séparées par des virgules — essayées au déchiffrement seulement.
MODULE_DATA_PREVIOUS_KEYS=

FRONTEND_URL=https://officedescoffres.creacube.be
CORS_ALLOWED_ORIGINS=https://officedescoffres.creacube.be

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Office des Coffres"

SEEDER_SUPER_ADMIN_EMAIL=
SEEDER_SUPER_ADMIN_PASSWORD=

# Client OAuth "password grant" (Passport) — voir database/seeders/PassportClientSeeder.php.
# Générer un UUID + une chaîne aléatoire de 40 caractères, une fois, et les garder stables :
# le seeder les réutilise pour recréer le même client après un migrate:fresh.
PASSPORT_PASSWORD_CLIENT_ID=
PASSPORT_PASSWORD_CLIENT_SECRET=

# Clés de chiffrement Passport, contenu PEM sur une seule ligne (sauts de ligne réels remplacés
# par des "\n" littéraux, pas du base64) — voir README.md "Variables d'environnement" pour la
# commande de génération complète.
PASSPORT_PRIVATE_KEY=
PASSPORT_PUBLIC_KEY=

SWEET_ALERT_ALWAYS_LOAD_JS=true
